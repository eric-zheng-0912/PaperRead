{
  "name": "paperread-desktop",
  "version": "1.5.2+custom.6",
  "description": "PaperRead personal research workspace",
  "author": {
    "name": "YuriyLin"
  },
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build:backend": "python scripts/build_backend.py",
    "dist": "npm run dist:test",
    "dist:custom-upgrade": "npm run build:backend && electron-builder --publish never",
    "dist:test": "npm run build:backend && electron-builder --config electron/builder-test.cjs --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.eric-zheng-0912.paperread.custom",
    "productName": "PaperRead Custom",
    "protocols": [
      {
        "name": "PaperRead",
        "schemes": [
          "easyread",
          "paperread"
        ]
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "icon": "electron/assets/paperread.ico",
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/assets/paperread.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "installerIcon": "electron/assets/paperread.ico",
      "uninstallerIcon": "electron/assets/paperread.ico",
      "artifactName": "PaperRead-Setup-${version}.exe",
      "installerLanguages": [
        "zh_TW",
        "en_US"
      ],
      "language": "1028",
      "include": "electron/installer-safety.nsh",
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "allowElevation": false
    },
    "mac": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "publications",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "executableName": "PaperRead",
    "publish": null,
    "extraMetadata": {
      "name": "paperread-custom-desktop"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "paperreadChannel": "custom-upgrade"
}
